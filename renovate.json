{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Update docs Python dependencies together, including transitive dependencies through lock file maintenance",
      "matchManagers": [
        "pep621"
      ],
      "matchFileNames": [
        "docs/pyproject.toml",
        "docs/uv.lock"
      ],
      "rangeStrategy": "update-lockfile",
      "groupName": "docs",
      "lockFileMaintenance": {
        "enabled": true
      }
    },
    {
      "description": "Keep the docs Python requirement aligned with the documentation build environment",
      "matchManagers": [
        "pep621"
      ],
      "matchFileNames": [
        "docs/pyproject.toml"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "minimumReleaseAge": "90 days"
    }
  ]
}
